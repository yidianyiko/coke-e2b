E2B_API_KEY=
COKE_MODEL_API_KEY=
COKE_MODEL_BASE_URL=https://api.openai.com/v1

# Optional: GLM-5.3 supports low, high, max; leave empty for provider defaults.
COKE_MODEL_REASONING_EFFORT=

