# COKE_CHROMIUM_PATH=/usr/bin/chromium
# COKE_AUTH_FILE=/private/auth.json
# COKE_DATA_DIR=/private/coke-data
# COKE_BROWSER_GATEWAY_URL=https://YOUR_HOST/v1/browser/action
# COKE_INTEGRATION_TOKEN=
# COKE_PUBLIC_BASE_URL=https://YOUR_HOST
